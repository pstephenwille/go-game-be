{
  "extends": [
    "./tsconfig.base.json"
  ],
  "compilerOptions": {
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["config/*"],
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "config/**/*"
  ]
}